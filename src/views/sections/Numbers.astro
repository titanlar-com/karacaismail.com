---
import type { HomeViewModel } from '../../viewmodels/HomeViewModel'
interface Props { vm: Pick<HomeViewModel, 'stats' | 'principles'> }
const { stats, principles } = Astro.props.vm
---
<section class="section root" aria-labelledby="ilke-baslik">
  <div class="wrap">
    <dl class="stats">
      {stats.map((s) => (
        <div>
          <dt class="label">{s.label}</dt>
          <dd class="value" data-effect="count-up" data-to={s.value} data-suffix={s.suffix}><span data-out>{s.text}</span></dd>
        </div>
      ))}
    </dl>
    <div data-effect="reveal">
      <p class="eyebrow">Çalışma ilkelerim</p>
      <h2 id="ilke-baslik" class="title">Nasıl çalışırım?</h2>
    </div>
    <ul class="principles">
      {principles.map((p, i) => (
        <li data-effect="reveal" data-delay={i * 0.08}><h3>{p.title}</h3><p>{p.text}</p></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .root { background: var(--c-ink-2); }
  .stats { margin: 0 0 var(--space-5); display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); }
  .stats > div { display: flex; flex-direction: column-reverse; gap: 0.5rem; }
  .value { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: var(--fs-4); line-height: 1; color: var(--c-ember); font-variant-numeric: tabular-nums; }
  .label { color: var(--c-bone-dim); max-width: 18ch; }
  .title { font-size: var(--fs-4); margin-block: var(--space-2) var(--space-4); }
  .principles { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4) var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .principles h3 { font-size: var(--fs-2); margin-bottom: 0.5rem; }
  .principles p { color: var(--c-bone-dim); }
</style>
