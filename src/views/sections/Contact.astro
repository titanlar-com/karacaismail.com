---
import { ContactForm } from '../islands/ContactForm'
import type { HomeViewModel } from '../../viewmodels/HomeViewModel'
interface Props { vm: Pick<HomeViewModel, 'profile' | 'services'> }
const { profile, services } = Astro.props.vm
---
<section id="iletisim" class="section root" aria-labelledby="iletisim-baslik">
  <div class="wrap grid">
    <div data-effect="reveal">
      <p class="eyebrow">İletişim</p>
      <h2 id="iletisim-baslik" class="title">Bir sonraki adımı birlikte yazalım.</h2>
      <p class="lead">Hedefinizi birkaç cümleyle anlatın. Kapsam, süre ve çıktıyı yazılı olarak geri paylaşırım.</p>
      <ul class="links">
        <li><a href={`mailto:${profile.email}`}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M3 6h18v12H3zM3 7l9 7 9-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg> {profile.email}</a></li>
        <li><a href={profile.github} target="_blank" rel="noreferrer noopener"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 19c-4 1-4-2-6-2m12 4v-3.5c0-1 .1-1.400-.5-2 2.800-.3 5.500-1.400 5.500-6a4.600 4.600 0 0 0-1.300-3.200 4.200 4.200 0 0 0-.1-3.200s-1.100-.3-3.500 1.300a12.300 12.300 0 0 0-6.200 0C6.500 2.800 5.400 3.100 5.400 3.100a4.200 4.200 0 0 0-.1 3.200A4.600 4.600 0 0 0 4 9.500c0 4.600 2.700 5.700 5.500 6-.6.600-.6 1.200-.5 2V21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg> {profile.githubHandle}</a></li>
      </ul>
    </div>
    <div data-effect="reveal" data-delay="0.1"><ContactForm client:visible email={profile.email} topics={services.map((s) => s.title)} /></div>
  </div>
</section>

<style>
  .root { background: var(--c-ink-2); }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
  .title { font-size: var(--fs-4); max-width: 14ch; margin-block: var(--space-2) var(--space-3); }
  .lead { color: var(--c-bone-dim); max-width: 44ch; font-size: var(--fs-2); line-height: 1.45; }
  .links { list-style: none; padding: 0; margin: var(--space-3) 0 0; display: grid; gap: 0.25rem; }
  .links a { display: inline-flex; align-items: center; gap: 0.75rem; min-height: var(--target); color: var(--c-bone); text-underline-offset: 0.3em; text-decoration-color: var(--c-ember); overflow-wrap: anywhere; }
  @media (min-width: 56rem) { .grid { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--space-5); } }
</style>
