---
import type { HomeViewModel } from '../../viewmodels/HomeViewModel'
interface Props { vm: Pick<HomeViewModel, 'process'> }
const { process } = Astro.props.vm
---
<section id="surec" class="section root" aria-labelledby="surec-baslik" data-effect="process-rail">
  <div class="wrap grid">
    <div class="side">
      <p class="eyebrow">Süreç</p>
      <h2 id="surec-baslik" class="title">Dört adımda, belirsizlikten teslimata.</h2>
      <p class="lead">Her adımın sahibi, bağımlılığı ve kabul ölçütü yazılıdır.</p>
    </div>
    <ol class="steps">
      <svg class="rail" viewBox="0 0 2 100" preserveAspectRatio="none" aria-hidden="true"><path data-rail d="M1 0 V100" pathLength="1" fill="none" stroke="var(--c-ember)" stroke-width="2" vector-effect="non-scaling-stroke" /></svg>
      {process.map((s) => (
        <li class="step" data-step>
          <svg class="node" viewBox="0 0 48 48" aria-hidden="true">
            <circle data-ring cx="24" cy="24" r="21" fill="var(--c-ink)" stroke="var(--c-ember)" stroke-width="2" />
            <text x="24" y="30" text-anchor="middle" fill="var(--c-bone)" font-size="16" font-weight="700">{s.order}</text>
          </svg>
          <div data-body><h3>{s.title}</h3><p>{s.text}</p></div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .root { background: var(--c-ink-2); }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
  .title { font-size: var(--fs-4); max-width: 14ch; margin-block: var(--space-2); }
  .lead { color: var(--c-bone-dim); max-width: 40ch; }
  .steps { list-style: none; margin: 0; padding: 0; position: relative; display: grid; gap: var(--space-4); }
  .rail { position: absolute; left: 1.5rem; top: 1.5rem; bottom: 1.5rem; width: 2px; height: calc(100% - 3rem); overflow: visible; }
  .step { position: relative; display: grid; grid-template-columns: 3rem 1fr; gap: var(--space-3); align-items: start; }
  .node { width: 3rem; height: 3rem; position: relative; z-index: 1; }
  .step h3 { font-size: var(--fs-2); margin-bottom: 0.5rem; }
  .step p { color: var(--c-bone-dim); max-width: 46ch; }
  @media (min-width: 56rem) {
    .grid { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--space-5); }
    .side { position: sticky; top: 7rem; align-self: start; }
  }
</style>
