---
import BogazSvg from './art/BogazSvg.astro'
import type { Act } from '../../models/Content'
interface Props { act: Act }
const { act } = Astro.props
---
<section id="cizim" class="root" aria-labelledby="cizim-baslik" data-effect="illustration">
  <div class="stage">
    <div class="art"><BogazSvg label={act.alt} /></div>
    <div class="shade" aria-hidden="true"></div>
    <div class="wrap copy" data-copy>
      <p class="eyebrow">{act.kicker}</p>
      <h2 id="cizim-baslik">{act.title}</h2>
      <p class="text">{act.text}</p>
      <p class="note">{act.note}</p>
    </div>
  </div>
</section>

<style>
  .root { position: relative; height: 320svh; background: var(--c-ink); }
  .stage { position: sticky; top: 0; height: 100svh; overflow: clip; }
  .art { position: absolute; inset: 0; }
  .shade { position: absolute; inset: auto 0 0 0; height: 62%; background: linear-gradient(to top, color-mix(in srgb, var(--c-ink) 92%, transparent), transparent); pointer-events: none; }
  .copy { position: absolute; inset: auto 0 0 0; margin-inline: auto; padding-bottom: calc(var(--space-4) + env(safe-area-inset-bottom)); display: grid; gap: var(--space-2); }
  h2 { font-size: var(--fs-4); max-width: 12ch; }
  .text { max-width: 46ch; color: var(--c-bone); font-size: var(--fs-1); }
  .note { color: var(--c-gold); font-size: var(--fs-0); }
  @media (max-height: 34rem) { h2 { font-size: var(--fs-3); } .text { display: none; } }
</style>
