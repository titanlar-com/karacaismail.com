---
import type { HomeViewModel } from '../../viewmodels/HomeViewModel'
interface Props { vm: Pick<HomeViewModel, 'stages' | 'section'> }
const { stages, section } = Astro.props.vm
const s = section('yaklasim')
---
<section id="yaklasim" class="root" aria-labelledby="yaklasim-baslik" data-effect="particle-scene" data-words={JSON.stringify(stages.map((s) => s.word))}>
  <div class="sticky">
    <div class="head wrap">
      <p class="eyebrow">{s.eyebrow}</p>
      <h2 id="yaklasim-baslik" class="title">{s.title}</h2>
    </div>
    <canvas class="canvas" aria-hidden="true"></canvas>
    <div class="caption" aria-hidden="true">
      <div class="wrap cap-in">
        <p class="hint">{s.hint}</p>
        {stages.map((s, i) => (
          <div class="cap" data-cap={i + 1}>
            <span class="step">{String(i + 1).padStart(2, '0')} / {String(stages.length).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
    <ol class="list">
      {stages.map((s) => <li><h3>{s.title}</h3><p>{s.text}</p></li>)}
    </ol>
  </div>
</section>

<style>
  /* JS ve hareket yoksa: gerçek içerik düz bir liste olarak akar */
  .root { padding-block: var(--space-5); background: var(--c-ink); }
  .head { display: grid; gap: var(--space-2); }
  .title { font-size: var(--fs-3); max-width: 18ch; }
  .canvas, .caption { display: none; }
  .list { max-width: var(--maxw); margin: var(--space-4) auto 0; padding: 0 var(--gutter); list-style: none; display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  .list h3 { color: var(--c-ember); font-size: var(--fs-2); margin-bottom: 0.5rem; }

  /* Etkin sahne: yüksek bölüm + yapışkan görünüm penceresi */
  .root:global(.is-live) { height: 560svh; padding-block: 0; }
  .root:global(.is-live) .sticky { position: sticky; top: 0; height: 100svh; display: grid; grid-template-rows: auto minmax(0, 1fr) auto; overflow: clip; }
  .root:global(.is-live) .head { padding-top: calc(var(--nav-h) + var(--space-3)); width: 100%; max-width: var(--maxw); margin-inline: auto; }
  .root:global(.is-live) .canvas { display: block; width: 100%; height: 100%; min-height: 0; touch-action: pan-y; }
  .root:global(.is-live) .caption { display: block; padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom)); }
  .root:global(.is-live) .list { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); margin: 0; padding: 0; }
  .cap-in { display: grid; min-height: 9.5rem; align-content: end; }
  .cap { display: none; gap: 0.5rem; animation: cap-in 0.7s var(--ease-out); }
  .cap h3 { font-size: var(--fs-2); color: var(--c-ember); }
  .cap p { max-width: 52ch; font-size: var(--fs-1); }
  .step, .hint { font-size: var(--fs-0); color: var(--c-bone-dim); letter-spacing: 0.08em; }
  .hint { display: block; }
  .root[data-stage="1"] .hint, .root[data-stage="2"] .hint, .root[data-stage="3"] .hint, .root[data-stage="4"] .hint { display: none; }
  .root[data-stage="1"] .cap[data-cap="1"], .root[data-stage="2"] .cap[data-cap="2"], .root[data-stage="3"] .cap[data-cap="3"], .root[data-stage="4"] .cap[data-cap="4"] { display: grid; }
  @keyframes cap-in { from { opacity: 0; transform: translateY(1rem); } to { opacity: 1; transform: none; } }
  @media (max-height: 32.5rem) { .title { font-size: var(--fs-2); } }
</style>
