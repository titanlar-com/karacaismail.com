---
import { NavDrawer } from '../islands/NavDrawer'
import type { HomeViewModel } from '../../viewmodels/HomeViewModel'

interface Props { vm: Pick<HomeViewModel, 'profile' | 'nav'> }
const { vm } = Astro.props
const links = vm.nav.map((n) => ({ label: n.label, href: n.href }))
---
<header class="bar" data-effect="nav-solid">
  <div class="inner">
    <a href="/" class="brand" aria-label={`${vm.profile.name}, ana sayfa`}>
      <svg viewBox="0 0 64 64" width="32" height="32" aria-hidden="true"><path d="M18 14v36M44 14 24 34l20 16" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span>{vm.profile.name}</span>
    </a>
    <nav class="links" aria-label="Ana gezinme">
      {links.map((l) => <a href={l.href} data-scroll-link>{l.label}</a>)}
      <a href="/#iletisim" class="cta" data-scroll-link>İletişim</a>
    </nav>
    <NavDrawer client:idle links={links} />
  </div>
</header>

<style>
  .bar { position: fixed; inset: 0 0 auto 0; z-index: var(--z-nav); transition: background var(--dur-2), backdrop-filter var(--dur-2); }
  .bar[data-solid] { background: color-mix(in srgb, var(--c-ink) 78%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  .inner { max-width: var(--maxw); margin-inline: auto; padding: 0.5rem var(--gutter); display: flex; align-items: center; justify-content: space-between; min-height: 4rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.75rem; text-decoration: none; font-family: var(--font-display); font-weight: 700; font-size: var(--fs-1); color: var(--c-ember); min-height: var(--target); }
  .brand span { color: var(--c-bone); }
  .links { display: none; align-items: center; gap: 0.25rem; }
  .links a { color: var(--c-bone); text-decoration: none; padding: 0.6rem 0.9rem; min-height: var(--target); display: inline-flex; align-items: center; border-radius: var(--radius-pill); transition: color var(--dur-1); }
  .links a:hover { color: var(--c-ember); }
  .links a.cta { background: var(--c-ember); color: var(--c-ink); font-weight: 700; margin-left: 0.5rem; }
  .links a.cta:hover { background: var(--c-gold); color: var(--c-ink); }
  @media (min-width: 56rem) { .links { display: flex; } }
</style>
