---
import '@fontsource-variable/outfit'
import '../../styles/mantine.css'
import '../../styles/app.css'
import Footer from '../components/Footer.astro'
import Nav from '../components/Nav.astro'
import type { HomeViewModel } from '../../viewmodels/HomeViewModel'

interface Props {
  vm: Pick<HomeViewModel, 'profile' | 'nav'>
  title?: string
  description?: string
  path?: string
  jsonLd?: string
  noindex?: boolean
}
const { vm, path = '/', jsonLd } = Astro.props
const title = Astro.props.title ?? vm.profile.seo.title
const description = Astro.props.description ?? vm.profile.seo.description
const canonical = new URL(path, vm.profile.siteUrl).toString()
const og = new URL('/og.png', vm.profile.siteUrl).toString()
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#07090d" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!Astro.props.noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {Astro.props.noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip-link" href="#icerik">İçeriğe geç</a>
    <div class="progress" data-effect="scroll-progress" aria-hidden="true"></div>
    <Nav vm={vm} />
    <main id="icerik" tabindex="-1">
      <slot />
    </main>
    <Footer profile={vm.profile} />
    <script>
      import '../../motion/boot'
    </script>
  </body>
</html>
