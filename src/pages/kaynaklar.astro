---
import SourcesTable from '../views/islands/SourcesTable'
import BaseLayout from '../views/layouts/BaseLayout.astro'
import { SourcesPageViewModel } from '../viewmodels/SourcesPageViewModel'

// Sayfa ince tutulur (MVVM): veriyi ViewModel yükler, görünümler yalnızca sunar.
const vm = await SourcesPageViewModel.load()
const { section } = vm
---
<BaseLayout vm={vm} path="/kaynaklar" title={section.seoTitle} description={section.seoDescription}>
  <section class="page wrap">
    <header class="head">
      <p class="eyebrow">{section.eyebrow}</p>
      <h1>{section.title}</h1>
      <p class="intro">{section.lead}</p>
      <p class="credit">{section.hint}</p>
    </header>
    <SourcesTable client:load tools={vm.tools} />
  </section>
</BaseLayout>

<style>
  .page { padding-top: calc(var(--nav-h) + var(--space-4)); padding-bottom: var(--space-5); display: grid; gap: var(--space-4); min-width: 0; }
  .head { display: grid; gap: var(--space-2); justify-items: start; }
  h1 { font-size: var(--fs-3); max-width: 20ch; }
  .intro { font-size: var(--fs-1); max-width: var(--measure); color: var(--c-bone); }
  .credit { color: var(--c-bone-dim); font-size: var(--fs-0); }
</style>
